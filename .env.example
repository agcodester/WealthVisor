# =============================================================================
# WealthVisor — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your keys:
#   cp .env.example .env

# ─── Required ────────────────────────────────────────────────────────────────
# Groq API Key (free: https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# ─── Optional ────────────────────────────────────────────────────────────────
# NewsAPI Key (free 100 req/day: https://newsapi.org/register)
NEWS_API_KEY=your_newsapi_key_here

# ─── Infrastructure (do not change unless you modify docker-compose.yml) ────
QDRANT_URL=http://localhost:6333
DB_PATH=./data/wealth_visor.db

# ─── Feature Flags ──────────────────────────────────────────────────────────
# Set to true to use FinBERT for sentiment (requires torch + transformers)
# Set to false to use lightweight VADER + financial lexicon (default)
USE_FINBERT=false
